# --- LINUX CONFIGURATION ---
# DISPLAY_VAR=$DISPLAY
# X11_VOLUME=/tmp/.X11-unix

# --- WINDOWS CONFIGURATION ---
# 1. You must use an X Server like VcXsrv (see instructions below)
# 2. You must create an empty folder named "windows_x11_dummy" in your project root
#    to satisfy the volume mapping (even though Windows uses TCP, not the socket).
DISPLAY_VAR=host.docker.internal:0.0
X11_VOLUME=./.windows_x11_dummy
